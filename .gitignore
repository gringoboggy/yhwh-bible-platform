# ==============================================================================
# .gitignore — what NOT to track in git
# ==============================================================================
# Tracked: source code, content notes, planning docs, configuration, rendered
#          EPUB working files, ONIX metadata.
# Not tracked: auto-generated caches, backups, system folders, system caches.
# ==============================================================================

# --- Python bytecode & caches ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Auto-generated backups (β.1 ensure_backup target) ---
.backups/
*.bak

# --- System / environment caches ---
.cache/
.local/
.config/
.npm/
.npm-global/
.tools/
node_modules/
.npmrc
.wget-hsts

# --- Editor tempfiles ---
*~
.*.swp
.*.swo
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Claude Code local state (per-machine permissions, runtime locks) ---
# Ignore .claude/ contents (not the dir itself) so a negation can re-include
# the project-scoped allowlist below; git can't re-include a file if its
# parent directory is excluded.
.claude/*
# Carve-out: project-scoped allowlist (narrow patterns; safe to share)
# travels with the repo. Per-machine settings.local.json stays ignored.
!.claude/settings.json

# --- Build / temp artifacts ---
/tmp/
*.tmp
*.log
dashboard.html
coverage_heatmap.html

# --- Manifest output (regenerated by manifest.py --build) ---
content/notes/.manifest.json

# --- Per-edition EPUB output (regenerated by build_edition.py) ---
/editions/*.epub
/tmp/editions_*/
/tmp/full_*/

# --- Outputs directory (delivery zips, not source-tracked) ---
/mnt/user-data/outputs/

# --- Sensitive / per-environment (ξ.6) ---
# `.env` and any `*.env` file — never commit real secrets.
.env
*.env
.env.local
# Carve-out: `.env.example` is the documented skeleton (committed).
!.env.example
secrets/
credentials/

# --- Print POD covers (regenerated by print_cover.py) ---
content/print_covers/*.pdf

# Built EPUB artifacts at project root (regenerable, do not track)
/Ethiopian_Bible*.epub
/exports/
