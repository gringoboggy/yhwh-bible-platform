# ==============================================================================
# .gitignore — what NOT to track in git
# ==============================================================================
# Tracked: source code, content notes, planning docs, configuration, rendered
#          EPUB working files, ONIX metadata.
# Not tracked: auto-generated caches, backups, system folders, system caches.
# ==============================================================================

# --- Python bytecode & caches ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Auto-generated backups (β.1 ensure_backup target) ---
.backups/
*.bak

# --- System / environment caches ---
.cache/
.local/
.config/
.npm/
.npm-global/
.tools/
node_modules/
.npmrc
.wget-hsts

# --- Editor tempfiles ---
*~
.*.swp
.*.swo
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Claude Code local state (per-machine permissions, runtime locks) ---
.claude/

# --- Build / temp artifacts ---
/tmp/
*.tmp
*.log
dashboard.html
coverage_heatmap.html

# --- Manifest output (regenerated by manifest.py --build) ---
content/notes/.manifest.json

# --- Per-edition EPUB output (regenerated by build_edition.py) ---
/editions/*.epub
/tmp/editions_*/
/tmp/full_*/

# --- Outputs directory (delivery zips, not source-tracked) ---
/mnt/user-data/outputs/

# --- Sensitive / per-environment ---
*.env
.env.local
secrets/
credentials/

# --- Print POD covers (regenerated by print_cover.py) ---
content/print_covers/*.pdf

# Built EPUB artifacts at project root (regenerable, do not track)
/Ethiopian_Bible*.epub
/exports/
