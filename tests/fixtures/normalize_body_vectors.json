{
  "_about": "normalizeBody test-vector pack (Mac, turn 57) for the rich-text note editor — spec docs/superpowers/specs/2026-06-09-idiot-proof-app-design.md §2 'Normalize-on-save'. Companion contract doc: docs/superpowers/notes/2026-06-09-normalizebody-test-vectors.md. Harness contract: for every vector assert normalize(input) == expected AND normalize(expected) == expected (every expected form is a fixed point / idempotency). Vectors with js_only=true depend on browser CSS-shorthand parsing and are skipped by a Python mirror harness.",
  "_contract": {
    "allow": [
      "strong",
      "em",
      "a[href]",
      "br"
    ],
    "map": {
      "b": "strong",
      "i": "em",
      "span[font-weight:bold|bolder|>=600]": "strong",
      "span[font-style:italic]": "em",
      "span[both]": "strong>em (strong outer, canonical order)"
    },
    "unwrap": "every other element: emit children in place (text kept)",
    "block_boundary": "REFINEMENT (spec_gap b): when unwrapping a block container (div/p/h1-h6/blockquote/li/tr...), emit one <br> before each block sibling after the first, and strip the block's own single trailing <br> (engine padding) — otherwise multi-line notes collapse to one line",
    "drop_wholesale": "REFINEMENT (spec_gap c): script/style/template elements and comment nodes are dropped INCLUDING their text; literal 'keep text' would inject code into note bodies",
    "href": "REFINEMENT (spec_gap a): validate the RAW attribute string against ^(https?:|mailto:|#|/(?!/)) — the spec's ^(https?:|mailto:|#|/) admits protocol-relative //host; no trimming before validation; invalid/missing href => unwrap the <a> (keep children), never emit a bare <a>",
    "attributes": "on kept elements drop ALL attributes except a@href",
    "escaping": "text nodes: & < > escaped (&amp; &lt; &gt;), quotes raw, U+00A0 emitted as the raw character; attribute values: & \" < > escaped; pre-existing entities are single-escaped on the DOM text value (no double-escaping)",
    "br": "serialized exactly as <br>"
  },
  "vectors": [
    {
      "id": "w1",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-weight: bold;\">hot</span>",
      "expected": "<strong>hot</strong>"
    },
    {
      "id": "w2",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-weight: 700;\">x</span>",
      "expected": "<strong>x</strong>"
    },
    {
      "id": "w3",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-weight: 600;\">x</span>",
      "expected": "<strong>x</strong>",
      "note": "600 is the >= threshold boundary"
    },
    {
      "id": "w4",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-weight: 500;\">x</span>",
      "expected": "x",
      "note": "below threshold -> plain unwrap"
    },
    {
      "id": "w5",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-style: italic;\">x</span>",
      "expected": "<em>x</em>"
    },
    {
      "id": "w6",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-weight: bold; font-style: italic;\">x</span>",
      "expected": "<strong><em>x</em></strong>",
      "note": "canonical order: strong outer"
    },
    {
      "id": "w7",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-weight:bold\">a<span style=\"font-style:italic\">b</span></span>",
      "expected": "<strong>a<em>b</em></strong>"
    },
    {
      "id": "w8",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"color: red;\">x</span>",
      "expected": "x"
    },
    {
      "id": "w9",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-weight: normal;\">x</span>",
      "expected": "x"
    },
    {
      "id": "w10",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span class=\"Apple-style-span\">x</span>",
      "expected": "x",
      "note": "WebKit removeFormat/paste residue"
    },
    {
      "id": "w11",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font-weight: bolder;\">x</span>",
      "expected": "<strong>x</strong>",
      "note": "decision: relative 'bolder' treated as bold (some engines emit it)"
    },
    {
      "id": "w12",
      "group": "webkit-spans",
      "engine": "webkit",
      "input": "<span style=\"font: italic bold 12px serif\">x</span>",
      "expected": "<strong><em>x</em></strong>",
      "js_only": true,
      "note": "font shorthand sets el.style.fontStyle/fontWeight in browsers; Python mirrors can skip"
    },
    {
