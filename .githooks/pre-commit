#!/usr/bin/env bash
# Pre-commit hook (ω.37 — 2026-05-10).
#
# Runs ruff format --check + the Tier-3 preflight aggregator
# (scripts/lint_rules.py) on every commit. Catches the
# "ruff drift" class of failures BEFORE they reach the test
# suite (which surfaced 5+ times during ω.35-A/B sessions).
#
# Activation (one-time per clone):
#   git config core.hooksPath .githooks
#
# Bypass (use sparingly, with the user's explicit say-so):
#   git commit --no-verify
#
# Cross-platform: this is a POSIX shell script. On Windows,
# Git for Windows ships with bash and runs hooks via the
# embedded MSYS2 shell — no extra setup needed.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Locate Python. Prefer the project's venv if present, else
# system python3.
#
# Windows-Store-alias guard: on Windows, `python3` and `python` may
# resolve to the App-Installer alias under %LOCALAPPDATA%\Microsoft\
# WindowsApps\, which prints "Python was not found ..." and exits
# non-zero. `command -v` finds it (it's a real file in PATH), so we
# have to actually invoke `--version` to test if the interpreter is
# a real Python install.
try_python() {
  # Returns 0 if "$1 --version" runs successfully AND emits a
  # version string starting with "Python ", which the Store alias
  # does NOT (it prints "Python was not found" to stderr).
  out="$("$1" --version 2>&1)" || return 1
  case "$out" in
    Python\ *) return 0 ;;
    *) return 1 ;;
  esac
}

if [ -x ".venv/bin/python" ]; then
  PYTHON=".venv/bin/python"
elif [ -x ".venv/Scripts/python.exe" ]; then
  PYTHON=".venv/Scripts/python.exe"
elif command -v python3 >/dev/null 2>&1 && try_python python3; then
  PYTHON="python3"
elif command -v python >/dev/null 2>&1 && try_python python; then
  PYTHON="python"
elif command -v py >/dev/null 2>&1 && try_python "py -3"; then
  PYTHON="py -3"
else
  # Windows fallback: Git for Windows bash inherits the system PATH,
  # not the user PATH. nuget-style `pythoncore-*` installs live under
  # %LOCALAPPDATA%\Python\ and are invisible to `which` even though
  # they work fine from PowerShell. Search known install locations.
  for candidate in \
      "$HOME"/AppData/Local/Python/pythoncore-*/python.exe \
      /c/Python3*/python.exe \
      "/c/Program Files/Python3*/python.exe" ; do
    # Unmatched globs expand to the literal pattern; -x filters those out.
    if [ -x "$candidate" ] && try_python "$candidate"; then
      PYTHON="$candidate"
      break
    fi
  done
  if [ -z "${PYTHON:-}" ]; then
    echo "pre-commit: no working Python found; skipping checks." >&2
    exit 0
  fi
fi

echo "[pre-commit] running ruff format --check ..."
if ! "$PYTHON" -m ruff format --check . ; then
  echo ""
  echo "[pre-commit] ruff drift detected. Run:"
  echo "    $PYTHON -m ruff format ."
  echo "then re-stage and re-commit."
  echo ""
  echo "(Bypass with --no-verify if you know what you're doing.)"
  exit 1
fi

echo "[pre-commit] running scripts/lint_rules.py ..."
if ! "$PYTHON" scripts/lint_rules.py >/tmp/lint_rules.out 2>&1 ; then
  echo ""
  echo "[pre-commit] Tier-3 preflight failed. Last 30 lines:"
  echo ""
  tail -n 30 /tmp/lint_rules.out
  echo ""
  echo "Full output: /tmp/lint_rules.out"
  echo "(Bypass with --no-verify if you know what you're doing.)"
  exit 1
fi

echo "[pre-commit] ok"
exit 0
